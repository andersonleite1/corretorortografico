  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose --exclude tests/build.test.ts",
    "test:e2e": "cypress run --config baseUrl=http://localhost:3001",
    "test:e2e:open": "cypress open --config baseUrl=http://localhost:3001",
    "test:e2e:ci": "start-server-and-test 'npx next dev -p 3001' http://localhost:3001 test:e2e",
    "db:push": "ln -sf .env.local .env && npx prisma db push && rm .env",
    "prepare": "husky"
  },
