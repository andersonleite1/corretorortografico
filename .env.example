# Aplicação pública — sem banco de dados ou autenticação
NEXT_PUBLIC_APP_URL=https://corretorortografico.online

# LanguageTool: endpoints /v2/check separados por vírgula
LANGUAGETOOL_ENDPOINTS=https://languagetool.editordetexto.cloud/v2/check,https://languagetool.andersonleite.dev.br/v2/check

# Conversão em PDF (opcional; padrão local: http://localhost:8080)
GOTENBERG_URL=
GOTENBERG_API_BASIC_AUTH_USERNAME=
GOTENBERG_API_BASIC_AUTH_PASSWORD=

# Tokens públicos de verificação dos buscadores (opcionais)
# Preencher com os códigos fornecidos pelos painéis, antes do build/deploy.
# Informar apenas o conteúdo do token, não a metatag HTML completa.
# A verificação por DNS dispensa estes tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
